# Variables para la DEMO publicada (Netlify o Vercel · Firebase Spark + Supabase, todo gratis).
# 1) Copiala a .env.demo y completala.
# 2) En Netlify: Environment variables > Import from a .env file > pegá este contenido.

NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_STORAGE_DRIVER=supabase
APP_URL=https://instante-demo.netlify.app

# --- Firebase (plan Spark gratuito: Authentication + Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Supabase (Project Settings > API). La service_role es SECRETA: solo servidor.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (credenciales DE PRUEBA)
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=
# Cuenta compradora de prueba que se muestra a los visitantes para pagar.
NEXT_PUBLIC_DEMO_MP_BUYER_USER=
NEXT_PUBLIC_DEMO_MP_BUYER_PASS=
# Código de verificación al iniciar sesión: últimos 6 dígitos del ID de usuario del comprador de prueba.
NEXT_PUBLIC_DEMO_MP_BUYER_CODE=

# --- Correo
DOWNLOAD_LINK_HOURS=48
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
