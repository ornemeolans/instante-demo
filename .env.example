# Copiá este archivo a .env.local y completá los valores.

# --- URL pública de la app (sin barra final). En local: http://localhost:3000
APP_URL=http://localhost:3000

# --- Firebase (cliente: Consola Firebase > Configuración del proyecto > Tus apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (Configuración > Cuentas de servicio > Generar nueva clave privada)
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@tu-proyecto.iam.gserviceaccount.com
# Pegala entre comillas, con los \n literales tal como vienen en el JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app

# --- Mercado Pago (Tus integraciones > Credenciales). Usá las de prueba primero.
MP_ACCESS_TOKEN=APP_USR-...
# Tus integraciones > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=

# --- Entrega
DOWNLOAD_LINK_HOURS=48

# --- Correo (SMTP: Gmail con contraseña de aplicación, Resend SMTP, Brevo, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Fotoventa <no-reply@tudominio.com>"
