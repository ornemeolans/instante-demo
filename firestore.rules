rules_version = '2';

// Todo el acceso a Firestore pasa por el servidor de Next.js (Admin SDK),
// que ignora estas reglas. El navegador no puede leer ni escribir nada:
// así ni los pedidos, ni los tokens de descarga, ni las rutas de los
// originales quedan expuestos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
