# Modo de pruebas GRATIS con el Firebase Local Emulator Suite.
# Copialo a .env.local:   copy .env.emulators.example .env.local
# No hace falta ningún proyecto ni credencial de Firebase.

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
APP_URL=http://localhost:3000

# Mercado Pago: credenciales DE PRUEBA (gratis). Tus integraciones > Credenciales de prueba.
# Sin esto podés probar todo menos el pago.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

DOWNLOAD_LINK_HOURS=48

# Sin SMTP: el correo con el enlace de descarga se imprime en la terminal de `npm run dev`.
